<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="RoboGestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades registradas -->
        <class>py.edu.une.politecnica.robogest.entity.Integrante</class>
        <class>py.edu.une.politecnica.robogest.entity.Asistencia</class>
        <class>py.edu.une.politecnica.robogest.entity.Categoria</class>
        <class>py.edu.une.politecnica.robogest.entity.Material</class>
        <class>py.edu.une.politecnica.robogest.entity.Proyecto</class>
        <class>py.edu.une.politecnica.robogest.entity.IntegranteProyecto</class>
        <class>py.edu.une.politecnica.robogest.entity.Prestamo</class>
        <class>py.edu.une.politecnica.robogest.entity.DetallePrestamo</class>
        <class>py.edu.une.politecnica.robogest.entity.ProyectoMaterial</class>

        <properties>
            <!-- Configuracion de conexion JDBC para MySQL 8 -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/club_robotica?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true&amp;characterEncoding=UTF-8"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root_password"/>

            <!-- Dialecto de Hibernate para MySQL 8 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>

            <!-- Validacion de esquema contra la BD existente (no sobrescribe) -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Logs y formato de consultas SQL -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
